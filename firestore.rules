rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == 'admin';
    }

    function isMaharaj() {
      return isSignedIn() && userDoc().data.role == 'maharaj';
    }

    function isKitchenLeader() {
      return isSignedIn() && userDoc().data.role == 'kitchen_leader';
    }

    function isRoomLeader() {
      return isSignedIn() && userDoc().data.role == 'room_leader';
    }

    function canManageVoteLocks() {
      return isAdmin() || isMaharaj() || isKitchenLeader();
    }

    /** Vote dashboard + Users/Seva management need member names. */
    function canReadAllUsers() {
      return isAdmin() || isMaharaj() || isKitchenLeader() || isRoomLeader();
    }

    function isResident() {
      return isSignedIn() && userDoc().data.role == 'resident';
    }

    function canWriteMenus() {
      return isApproved() && (
        isAdmin() || isKitchenLeader() || isRoomLeader() || isResident()
      );
    }

    function canWriteMenuCatalog() {
      return isAdmin() || isKitchenLeader();
    }

    function canDeleteParticipations() {
      return canWriteMenus();
    }

    function canManageSeva() {
      return isAdmin() || isRoomLeader();
    }

    function canManageLeaves() {
      return isAdmin() || isKitchenLeader() || isRoomLeader();
    }

    function canCreateLeaves() {
      return isApproved() && !isMaharaj();
    }

    function canManageNotices() {
      return isAdmin() || isRoomLeader();
    }

    function canManagePush() {
      return isAdmin() || isKitchenLeader() || isRoomLeader();
    }

    function canViewNoticeAnalytics() {
      return isAdmin() || isRoomLeader() || isKitchenLeader();
    }

    function canManageStocks() {
      return isAdmin() || isKitchenLeader();
    }

    function canManageFinance() {
      return isAdmin() || isRoomLeader();
    }

    function isFinanceViewer() {
      return isApproved() && !isMaharaj();
    }

    function ownFinanceDue(dueId) {
      return dueId is string
        && exists(/databases/$(database)/documents/financeDues/$(dueId))
        && get(/databases/$(database)/documents/financeDues/$(dueId)).data.userId == request.auth.uid;
    }

    function dueRoundingPaise(dueId) {
      return get(/databases/$(database)/documents/financeDues/$(dueId)).data.roundingDeltaPaise;
    }

    function isOwnRoundingMovement() {
      return isFinanceViewer()
        && request.resource.data.reason == 'rounding'
        && request.resource.data.refType == 'financeDue'
        && ownFinanceDue(request.resource.data.refId)
        && request.resource.data.amountPaise is number
        && (
          request.resource.data.amountPaise == dueRoundingPaise(request.resource.data.refId)
          || request.resource.data.amountPaise == -dueRoundingPaise(request.resource.data.refId)
        );
    }

    function isOwnRoundingWalletUpdate() {
      return isFinanceViewer()
        && request.resource.data.lastRoundingDueId is string
        && ownFinanceDue(request.resource.data.lastRoundingDueId)
        && request.resource.data.balancePaise is number
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['balancePaise', 'updatedAt', 'lastRoundingDueId'])
        && (
          request.resource.data.balancePaise
            == resource.data.balancePaise + dueRoundingPaise(request.resource.data.lastRoundingDueId)
          || request.resource.data.balancePaise
            == resource.data.balancePaise - dueRoundingPaise(request.resource.data.lastRoundingDueId)
        );
    }

    function isOwnDueWalletAppliedUpdate() {
      return isFinanceViewer()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletApplied'])
        && request.resource.data.walletApplied is bool;
    }

    function canEditStockGroupDoc(groupId) {
      return canManageStocks() || (
        isApproved() &&
        request.auth.uid in get(/databases/$(database)/documents/stockGroups/$(groupId)).data.editorUserIds
      );
    }

    function isShoppingAssignee() {
      return isApproved() && request.auth.uid in resource.data.assigneeIds;
    }

    /**
     * Room leaders may update/delete non-admin users and may not assign admin.
     * They also cannot change their own role/status via this path.
     */
    function roomLeaderCanManageUser(userId) {
      return isRoomLeader()
        && resource.data.role != 'admin'
        && request.resource.data.role != 'admin'
        && (
          request.auth.uid != userId
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])
        );
    }

    function roomLeaderCanDeleteUser() {
      return isRoomLeader() && resource.data.role != 'admin';
    }

    function isApproved() {
      return isSignedIn() && (
        isAdmin() ||
        userDoc().data.status == 'approved' ||
        !('status' in userDoc().data)
      );
    }

    function slotLocked(dateId, slot) {
      return exists(/databases/$(database)/documents/voteLocks/$(dateId + '_' + slot)) &&
        get(/databases/$(database)/documents/voteLocks/$(dateId + '_' + slot)).data.locked == true;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || canReadAllUsers()
        || isFinanceViewer()
        || resource.data.role == 'maharaj'
      );
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin()
        || roomLeaderCanManageUser(userId)
        || (
          isSignedIn() &&
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])
        );
      allow delete: if isAdmin() || roomLeaderCanDeleteUser();

      match /fcmTokens/{tokenId} {
        allow read: if isSignedIn() && (
          request.auth.uid == userId || canManagePush()
        );
        allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if false;
        allow update: if isApproved()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['seenAt', 'readAt', 'clearedAt']);
        allow delete: if false;
      }
    }

    match /voteLocks/{lockId} {
      allow read: if isSignedIn();
      allow write: if canManageVoteLocks();
    }

    match /mealParticipation/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isApproved() &&
        request.resource.data.userId == request.auth.uid &&
        !slotLocked(request.resource.data.date, request.resource.data.slot);
      allow delete: if canDeleteParticipations();
    }

    match /menus/{menuId} {
      allow read: if isSignedIn();
      allow write: if canWriteMenus();
    }

    match /menuCategories/{id} {
      allow read: if isSignedIn();
      allow write: if canWriteMenuCatalog();
    }

    match /menuItems/{id} {
      allow read: if isSignedIn();
      allow write: if canWriteMenuCatalog();
    }

    match /sevaRoom/{docId} {
      allow read: if isSignedIn();
      allow write: if canManageSeva();
    }

    match /leaveEntries/{docId} {
      allow read: if isSignedIn();
      allow create: if canCreateLeaves()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.period in ['morning', 'evening', 'full']
        && request.resource.data.recordedBy == request.auth.uid;
      allow update, delete: if canManageLeaves();
    }

    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageNotices();

      match /receipts/{userId} {
        allow read: if canViewNoticeAnalytics()
          || (isSignedIn() && request.auth.uid == userId);
        allow create, update: if isApproved()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if canManageNotices();
      }
    }

    match /pushSettings/{docId} {
      allow read: if isSignedIn();
      allow write: if canManagePush();
    }

    match /pushJobs/{jobId} {
      allow read: if canManagePush();
      allow create, update: if canManagePush();
      allow delete: if canManagePush();
    }

    match /pushLogs/{logId} {
      allow read: if canManagePush();
      allow write: if false;
    }

    match /pushDigestCursor/{docId} {
      allow read: if canManagePush();
      allow write: if false;
    }

    match /stockGroups/{groupId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageStocks();
    }

    match /stockItems/{itemId} {
      allow read: if isSignedIn();
      allow create: if canEditStockGroupDoc(request.resource.data.groupId);
      allow delete: if canEditStockGroupDoc(resource.data.groupId);
      // Group editors manage all fields; any approved user may adjust qty
      // (shopping ticket fill / planned consume run client-side).
      allow update: if canEditStockGroupDoc(resource.data.groupId)
        || (
          isApproved() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['quantity', 'lastFilledAt', 'lastUsedAt', 'updatedAt'])
        );
    }

    match /stockMovements/{moveId} {
      allow read: if isSignedIn();
      allow create: if isApproved();
      allow update, delete: if false;
    }

    match /shoppingTickets/{ticketId} {
      allow read: if isSignedIn();
      allow create: if canManageStocks();
      allow update: if canManageStocks() || isShoppingAssignee();
      allow delete: if canManageStocks();
    }

    match /financeSettings/{docId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if canManageFinance();
    }

    match /expenseTemplates/{docId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if canManageFinance();
    }

    match /expenses/{docId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if canManageFinance();
    }

    match /financeCollections/{docId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if canManageFinance();
    }

    match /roomWallet/{docId} {
      allow read: if isFinanceViewer();
      allow create, delete: if canManageFinance();
      allow update: if canManageFinance() || isOwnRoundingWalletUpdate();
    }

    match /depositAccounts/{userId} {
      allow read: if canManageFinance() || (isFinanceViewer() && request.auth.uid == userId);
      allow create, update, delete: if canManageFinance();
    }

    match /financeDues/{dueId} {
      allow read: if isFinanceViewer();
      allow create, delete: if canManageFinance();
      allow update: if canManageFinance() || isOwnDueWalletAppliedUpdate();
    }

    match /financePayments/{paymentId} {
      allow read: if isFinanceViewer();
      allow create: if canManageFinance()
        || (
          isFinanceViewer()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.recordedBy == request.auth.uid
          && request.resource.data.dueId is string
          && request.resource.data.amountPaise is number
          && request.resource.data.amountPaise > 0
          && request.resource.data.voided == false
          && request.resource.data.source == 'member'
          && get(/databases/$(database)/documents/financeDues/$(request.resource.data.dueId)).data.userId == request.auth.uid
          && get(/databases/$(database)/documents/financeDues/$(request.resource.data.dueId)).data.collectionId == request.resource.data.collectionId
        );
      allow update: if canManageFinance();
      allow delete: if canManageFinance();
    }

    match /depositMovements/{moveId} {
      allow read: if canManageFinance()
        || (isFinanceViewer() && resource.data.userId == request.auth.uid);
      allow create: if canManageFinance();
      allow update, delete: if false;
    }

    match /roomWalletMovements/{moveId} {
      allow read: if isFinanceViewer();
      allow create: if canManageFinance() || isOwnRoundingMovement();
      allow update: if false;
      allow delete: if canManageFinance();
    }

    match /memberWallets/{userId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if canManageFinance();
    }

    match /memberWalletMovements/{moveId} {
      allow read: if isFinanceViewer();
      allow create: if canManageFinance();
      allow update: if false;
      allow delete: if canManageFinance();
    }

    match /financeFundRepairs/{docId} {
      allow read: if isFinanceViewer();
      allow create: if canManageFinance();
      allow update: if false;
      allow delete: if canManageFinance();
    }

    match /financeWalletRepayments/{docId} {
      allow read: if isFinanceViewer();
      allow create: if isFinanceViewer()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amountPaise is number
        && request.resource.data.amountPaise > 0;
      allow update: if canManageFinance()
        || (
          isFinanceViewer()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.amountPaise == resource.data.amountPaise
        );
      allow delete: if canManageFinance();
    }
  }
}
